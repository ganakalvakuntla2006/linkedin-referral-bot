# LinkedIn Account Session Cookie (Mandatory for 24/7 Cloud Auth)
# Instructions to get li_at cookie:
# 1. Open linkedin.com in your desktop browser.
# 2. Press F12 -> Go to Application tab -> Cookies -> https://www.linkedin.com
# 3. Copy the value of "li_at" cookie and paste it below:
LINKEDIN_LI_AT_COOKIE=your_li_at_cookie_here

# Bot Operation Parameters
POLL_INTERVAL_MINUTES=2
DAILY_MESSAGE_LIMIT=15
SAFETY_DELAY_MIN_SEC=45
SAFETY_DELAY_MAX_SEC=90

# Optional Telegram Phone Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Target Tech Role Keywords (comma-separated)
TARGET_KEYWORDS="Software Engineer, SDE, Frontend, Backend, Full Stack, DevOps, Data Engineer, Tech Lead, Engineering Manager, engineering, software, developer, mts, cse"

# User's Custom Referral Message Template
MESSAGE_TEMPLATE="Hi {firstName}, I’m Gana, a fourth-year student at IIITL. I recently completed my internship at Google.\n\nI wanted to ask if you could refer me internally at {company} for any suitable Software Engineering opportunities. I’d really appreciate your help. Thank you!"
